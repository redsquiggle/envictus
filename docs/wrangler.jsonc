{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "envictus-docs",
	"compatibility_date": "2025-09-02",
	"workers_dev": true,
	"assets": {
		"directory": "dist"
	},
	"routes": [
		{ "pattern": "envictus.dev", "custom_domain": true },
		{ "pattern": "www.envictus.dev", "custom_domain": true }
	]
}
